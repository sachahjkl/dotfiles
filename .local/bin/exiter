#!/bin/sh
case "$1" in
    lock)
        locker
        ;;
    logout)
       case "$XDG_CURRENT_DESKTOP" in
          sway) swaymsg exit;;
          i3) i3-msg exit;;
          *) killall Xorg;;
       esac
       ;;
    suspend)
        lock && systemctl suspend
        ;;
    hibernate)
        lock && systemctl hibernate
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown)
        systemctl poweroff
        ;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
esac

exit 0
