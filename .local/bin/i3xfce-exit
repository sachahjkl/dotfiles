#!/bin/sh
lock() {
    i3lock -f -k -B=10 --indicator --datecolor=FFFFFFFF --timecolor=FFFFFFFF
}

case "$1" in
    lock)
        lock
        ;;
    logout)
        xfce4-session-logout
        ;;
    suspend)
        lock && systemctl suspend
        ;;
    hibernate)
        lock && systemctl hibernate
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown)
        systemctl poweroff
        ;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
esac

exit 0
