#!/bin/sh

# This file runs when a DM logs you into a graphical session.
# If you use startx/xinit like a Chad, this file will also be sourced.

mpd &
remaps &

setxkbmap -layout fr &
nitrogen --restore
picom -b
nm-applet &
blueman-applet &
mpd ~/.config/mpd/mpd.conf &
laptop_mode &
cbatticon &
psensor &
orage &
xss-lock --transfer-sleep-lock -- i3lock -f -m -k -B=10 --indicator --datecolor=FFFFFFFF --timecolor=FFFFFFFF &

dunst &
pasystray &
unclutter &
